# Copy to ".env" and fill in. The .env file is git-ignored — keep your credentials local.

# --- myAudi account (same login as the myAudi phone app) ---
AUDI_USERNAME=you@example.com
AUDI_PASSWORD=your-myaudi-password
# Two-letter country code for your myAudi account, e.g. GB, DE, US.
AUDI_COUNTRY=GB
# Security PIN (S-PIN). Only needed for remote actions; leave blank for read-only battery checks.
AUDI_SPIN=
# Optional: pin to one car by VIN. If you only have one vehicle you can leave this blank.
AUDI_VIN=
# Audi API format: 1 = e-tron / Q4 (newer electric format, default), 0 = legacy petrol/diesel.
AUDI_API_LEVEL=1

# --- Alert threshold ---
# Notify when the battery is strictly below this percentage.
BATTERY_THRESHOLD=40

# --- Notifications ---
# One of: ntfy (default), pushover, telegram
NOTIFY_BACKEND=ntfy
# Send a push if the nightly check itself fails (login/network error). Off by default to
# avoid noise from transient myAudi outages.
NOTIFY_ON_ERROR=false

# ntfy: install the ntfy app, subscribe to this (unguessable!) topic, and put its name here.
NTFY_TOPIC=audi-q4-change-me-to-something-random
NTFY_SERVER=https://ntfy.sh

# pushover (if NOTIFY_BACKEND=pushover)
PUSHOVER_TOKEN=
PUSHOVER_USER=

# telegram (if NOTIFY_BACKEND=telegram)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
